# Pruebas de la API FrescoAlerta

@baseUrl = http://localhost:3000/api/alimentos


#Listar los alimentos 
# Te trae la lista ordenada por fecha de vencimiento 
GET {{baseUrl}}

### Filtrar por categoría
GET {{baseUrl}}?categoria=lacteos

### Filtrar los que vencen en los próximos 7 días
GET {{baseUrl}}?porVencer=7


#Registrar un alimento 

POST {{baseUrl}}
Content-Type: application/json

{
  "nombre": "Pollo asado",
  "cantidad": 1,
  "categoria": "carnes",
  "fechaVencimiento": "2027-01-15"
}

#Prueba de Validación
POST {{baseUrl}}
Content-Type: application/json

{}


#Editar un alimento 
PUT {{baseUrl}}/{{registrar.response.body.$.data._id}}
Content-Type: application/json

{
  "cantidad": 2
}


#Buscar recetas en la API externa según el alimento
GET {{baseUrl}}/{{registrar.response.body.$.data._id}}/recetas


#Eliminar el alimento creado en las pruebas 
DELETE {{baseUrl}}/{{registrar.response.body.$.data._id}}

#Intentar borrarlo de nuevo 
DELETE {{baseUrl}}/{{registrar.response.body.$.data._id}}

#Probar con un ID con formato inválido
DELETE {{baseUrl}}/123
#Borrar un ítem específico que quedó volando por ahí
DELETE {{baseUrl}}/6adae39d0cea2456893d857e