# Pruebas de la API FrescoAlerta

@baseUrl = http://localhost:3000/api/alimentos


### RUTA 2 - Listar los alimentos 
# Devuelve la lista ordenada por vencimiento 
GET {{baseUrl}}

### Filtrar por categoría
GET {{baseUrl}}?categoria=lacteos

### Filtrar los que vencen en los próximos 7 días
GET {{baseUrl}}?porVencer=7


### RUTA 1 - Registrar un alimento 

POST {{baseUrl}}
Content-Type: application/json

{
  "nombre": "Pollo asado",
  "cantidad": 1,
  "categoria": "carnes",
  "fechaVencimiento": "2027-01-15"
}

### Validación
POST {{baseUrl}}
Content-Type: application/json

{}


### RUTA 3 - Editar un alimento 
# Usa el id del alimento que se registró arriba.
PUT {{baseUrl}}/{{registrar.response.body.$.data._id}}
Content-Type: application/json

{
  "cantidad": 2
}


### RUTA 5 - API externa: recetas para aprovechar el alimento 
GET {{baseUrl}}/{{registrar.response.body.$.data._id}}/recetas


### RUTA 4 - Eliminar un alimento 
DELETE {{baseUrl}}/{{registrar.response.body.$.data._id}}

### Eliminar de nuevo 
DELETE {{baseUrl}}/{{registrar.response.body.$.data._id}}

### Id con formato inválido 
DELETE {{baseUrl}}/123